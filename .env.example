# =============================================================================
# CONFIGURACIÓN DE ENTORNO - ACADEMIA FELINA FLOPPA
# Copia este archivo a .env y completa los valores reales
# =============================================================================

# Django
SECRET_KEY=tu-secret-key-super-secreta-aqui-generala-con-django-secret-key-generator
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de Datos PostgreSQL (OBLIGATORIO según pauta - NO SQLite)
DB_NAME=academia_felina
DB_USER=postgres
DB_PASSWORD=tu-password-postgres
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True